# Copy to .env on the server. Keep this file private and outside the web root.
HOST=127.0.0.1
PORT=3077
SITE_ORIGIN=https://jaxgo.ru,https://www.jaxgo.ru
TRUST_PROXY=1
LEAD_CHANNELS=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# If the MAX API certificate is not trusted by Node, install the official CA file and set NODE_EXTRA_CA_CERTS before starting the service.
# NODE_EXTRA_CA_CERTS=/opt/jaxgo/certs/russian-trusted-root-ca.pem
