# jaxgo.ru: основной адрес без www, сжатие и кеширование статики.
DirectoryIndex index.html
Options -Indexes

# Спринтхост передаёт внешний протокол в X-Forwarded-Proto.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Старые адреса статей и явные index.html ведут сразу на конечный URL.
  RewriteCond %{THE_REQUEST} \s/+articles/index\.html[?\s] [NC]
  RewriteRule ^articles/index\.html$ https://jaxgo.ru/articles/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+articles/[a-z0-9-]+\.html[?\s] [NC]
  RewriteCond %{REQUEST_FILENAME} ^(.+)\.html$
  RewriteCond %1/index.html -f
  RewriteRule ^articles/([a-z0-9-]+)\.html$ https://jaxgo.ru/articles/$1/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+articles/(?:[a-z0-9-]+/|page/[0-9]+/)index\.html[?\s] [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(articles/(?:[a-z0-9-]+/|page/[0-9]+/))index\.html$ https://jaxgo.ru/$1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(articles(?:/[a-z0-9-]+|/page/[0-9]+)?)$ https://jaxgo.ru/$1/ [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?jaxgo\.ru(?::\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://jaxgo.ru%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Сжатие текстовых ресурсов.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Кеширование. CSS и JS подключаются с ?v=версия, поэтому их можно хранить долго.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^site-config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
