# jaxgo.ru: основной адрес без www, сжатие и кеширование статики.
DirectoryIndex index.html
Options -Indexes

# Спринтхост передаёт внешний протокол в X-Forwarded-Proto.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Старые адреса статей и явные index.html ведут сразу на конечный URL.
  RewriteCond %{THE_REQUEST} \s/+articles/index\.html[?\s] [NC]
  RewriteRule ^articles/index\.html$ https://jaxgo.ru/articles/ [R=301,L,NE]
  RewriteRule ^articles/obedinit-praisy-postavshchikov\.html$ https://jaxgo.ru/articles/obedinit-praisy-postavshchikov/ [R=301,L,NE]
  RewriteRule ^articles/lending-ili-mnogostranichnyi-sait\.html$ https://jaxgo.ru/articles/lending-ili-mnogostranichnyi-sait/ [R=301,L,NE]
  RewriteRule ^articles/zayavki-s-saita-v-telegram\.html$ https://jaxgo.ru/articles/zayavki-s-saita-v-telegram/ [R=301,L,NE]
  RewriteRule ^articles/obnovlenie-ostatkov-postavshchikov\.html$ https://jaxgo.ru/articles/obnovlenie-ostatkov-postavshchikov/ [R=301,L,NE]
  RewriteRule ^articles/s-chego-nachat-avtomatizatsiyu\.html$ https://jaxgo.ru/articles/s-chego-nachat-avtomatizatsiyu/ [R=301,L,NE]
  RewriteRule ^articles/chto-podgotovit-dlya-saita\.html$ https://jaxgo.ru/articles/chto-podgotovit-dlya-saita/ [R=301,L,NE]
  RewriteRule ^articles/avtomatizatsiya-kommercheskih-predlozhenii\.html$ https://jaxgo.ru/articles/avtomatizatsiya-kommercheskih-predlozhenii/ [R=301,L,NE]
  RewriteRule ^articles/natsenka-v-praise\.html$ https://jaxgo.ru/articles/natsenka-v-praise/ [R=301,L,NE]
  RewriteRule ^articles/na-saite-net-zayavok\.html$ https://jaxgo.ru/articles/na-saite-net-zayavok/ [R=301,L,NE]
  RewriteRule ^articles/bot-dlya-vyezdnyh-menedzherov\.html$ https://jaxgo.ru/articles/bot-dlya-vyezdnyh-menedzherov/ [R=301,L,NE]
  RewriteRule ^articles/internet-magazin-ili-b2b-portal\.html$ https://jaxgo.ru/articles/internet-magazin-ili-b2b-portal/ [R=301,L,NE]
  RewriteRule ^articles/otchet-dlya-sobstvennika\.html$ https://jaxgo.ru/articles/otchet-dlya-sobstvennika/ [R=301,L,NE]
  RewriteRule ^articles/avito-i-ostatki-postavshchikov\.html$ https://jaxgo.ru/articles/avito-i-ostatki-postavshchikov/ [R=301,L,NE]
  RewriteRule ^articles/integratsiya-saita-tablits-i-1c\.html$ https://jaxgo.ru/articles/integratsiya-saita-tablits-i-1c/ [R=301,L,NE]
  RewriteRule ^articles/zadachi-iz-telegram-v-kalendar\.html$ https://jaxgo.ru/articles/zadachi-iz-telegram-v-kalendar/ [R=301,L,NE]
  RewriteRule ^articles/kontent-iz-kataloga-tovarov\.html$ https://jaxgo.ru/articles/kontent-iz-kataloga-tovarov/ [R=301,L,NE]
  RewriteRule ^articles/sravnenie-tovarov-postavshchikov\.html$ https://jaxgo.ru/articles/sravnenie-tovarov-postavshchikov/ [R=301,L,NE]
  RewriteRule ^articles/baza-instruktsii-kompanii\.html$ https://jaxgo.ru/articles/baza-instruktsii-kompanii/ [R=301,L,NE]
  RewriteRule ^articles/monitoring-zakupok-i-uvedomleniya\.html$ https://jaxgo.ru/articles/monitoring-zakupok-i-uvedomleniya/ [R=301,L,NE]
  RewriteRule ^articles/tablitsy-gotovaya-crm-ili-svoya\.html$ https://jaxgo.ru/articles/tablitsy-gotovaya-crm-ili-svoya/ [R=301,L,NE]
  RewriteRule ^articles/iz-chego-skladyvaetsya-tsena-saita\.html$ https://jaxgo.ru/articles/iz-chego-skladyvaetsya-tsena-saita/ [R=301,L,NE]
  RewriteRule ^articles/povtornyi-optovyi-zakaz\.html$ https://jaxgo.ru/articles/povtornyi-optovyi-zakaz/ [R=301,L,NE]
  RewriteRule ^articles/kak-prinyat-avtomatizatsiyu\.html$ https://jaxgo.ru/articles/kak-prinyat-avtomatizatsiyu/ [R=301,L,NE]
  RewriteRule ^articles/okupaemost-avtomatizatsii-zadachi\.html$ https://jaxgo.ru/articles/okupaemost-avtomatizatsii-zadachi/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+articles/(?:[a-z0-9-]+/|page/[0-9]+/)index\.html[?\s] [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(articles/(?:[a-z0-9-]+/|page/[0-9]+/))index\.html$ https://jaxgo.ru/$1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(articles(?:/[a-z0-9-]+|/page/[0-9]+)?)$ https://jaxgo.ru/$1/ [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?jaxgo\.ru(?::\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://jaxgo.ru%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Сжатие текстовых ресурсов.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Кеширование. CSS и JS подключаются с ?v=версия, поэтому их можно хранить долго.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^site-config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
